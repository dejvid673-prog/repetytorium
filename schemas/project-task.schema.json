{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dejvid673-prog/repetytorium/schemas/project-task.schema.json",
  "title": "Project task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "title",
    "context_version",
    "phase",
    "work_package",
    "classification",
    "status",
    "owner_agent",
    "executor_agents",
    "reviewer_agents",
    "separation_of_duties_confirmed",
    "scope",
    "depends_on",
    "required_gates",
    "required_environment",
    "inputs",
    "outputs",
    "acceptance_criteria",
    "test_plan",
    "blockers",
    "decision_ids",
    "evidence_paths",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^TASK-[0-9]{4,}$"
    },
    "title": {
      "type": "string",
      "minLength": 5
    },
    "context_version": {
      "type": "string",
      "minLength": 1
    },
    "phase": {
      "type": "string",
      "minLength": 1
    },
    "work_package": {
      "type": "string",
      "pattern": "^WP-[0-9]{4,5}$"
    },
    "classification": {
      "enum": [
        "plan_execution",
        "clarification",
        "reference_material",
        "change_request",
        "out_of_scope"
      ]
    },
    "status": {
      "enum": [
        "INTAKE",
        "CLASSIFIED",
        "IMPACT_REVIEW",
        "DECISION_REQUIRED",
        "BLOCKED",
        "READY",
        "ACTIVE",
        "REVIEW",
        "CHANGES_REQUIRED",
        "ACCEPTED",
        "MERGED",
        "CLOSED",
        "CANCELLED"
      ]
    },
    "owner_agent": {
      "enum": [
        "A00",
        "OWNER"
      ]
    },
    "executor_agents": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(A[0-9]{2}|OWNER)$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "reviewer_agents": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(A[0-9]{2}|OWNER)$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "separation_of_duties_confirmed": {
      "const": true
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "included",
        "excluded",
        "allowed_paths",
        "forbidden_paths"
      ],
      "properties": {
        "included": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "excluded": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowed_paths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "forbidden_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "required_gates": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "required_environment": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "version",
          "required"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          }
        }
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "description"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "test_plan": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "level",
          "reason",
          "owner",
          "unblock_evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "level": {
            "enum": [
              "B0",
              "B1",
              "B2",
              "B3",
              "B4"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "unblock_evidence": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "decision_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "branch": {
      "type": [
        "string",
        "null"
      ]
    },
    "pr_number": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "evidence_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "cancel_reason": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "DECISION_REQUIRED"
          }
        }
      },
      "then": {
        "properties": {
          "decision_ids": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "ACTIVE",
              "REVIEW",
              "CHANGES_REQUIRED",
              "ACCEPTED",
              "MERGED",
              "CLOSED"
            ]
          }
        }
      },
      "then": {
        "required": [
          "branch",
          "pr_number"
        ],
        "properties": {
          "branch": {
            "type": "string",
            "minLength": 1
          },
          "pr_number": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "ACCEPTED",
              "MERGED",
              "CLOSED"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "evidence_paths": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "CANCELLED"
          }
        }
      },
      "then": {
        "required": [
          "cancel_reason"
        ],
        "properties": {
          "cancel_reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}
