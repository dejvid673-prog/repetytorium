{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dejvid673-prog/repetytorium/schemas/project-task.schema.json",
  "title": "Project task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "title",
    "context_version",
    "phase",
    "work_package",
    "classification",
    "status",
    "owner_agent",
    "executor_agents",
    "reviewer_agents",
    "scope",
    "depends_on",
    "inputs",
    "outputs",
    "acceptance_criteria",
    "test_plan",
    "blockers"
  ],
  "properties": {
    "task_id": {"type": "string", "pattern": "^TASK-[0-9]{4,}$"},
    "title": {"type": "string", "minLength": 5},
    "context_version": {"type": "string", "minLength": 1},
    "phase": {"type": "string", "minLength": 1},
    "work_package": {"type": "string", "pattern": "^WP-[0-9]{4,5}$"},
    "classification": {
      "enum": ["plan_execution", "clarification", "reference_material", "change_request", "out_of_scope"]
    },
    "status": {
      "enum": ["INTAKE", "CLASSIFIED", "IMPACT_REVIEW", "DECISION_REQUIRED", "BLOCKED", "READY", "ACTIVE", "REVIEW", "CHANGES_REQUIRED", "ACCEPTED", "MERGED", "CLOSED", "CANCELLED"]
    },
    "owner_agent": {"const": "A00"},
    "executor_agents": {
      "type": "array",
      "items": {"type": "string", "pattern": "^A[0-9]{2}$"},
      "minItems": 1,
      "uniqueItems": true
    },
    "reviewer_agents": {
      "type": "array",
      "items": {"type": "string", "pattern": "^A[0-9]{2}$"},
      "minItems": 1,
      "uniqueItems": true
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["included", "excluded", "allowed_paths", "forbidden_paths"],
      "properties": {
        "included": {"type": "array", "items": {"type": "string"}},
        "excluded": {"type": "array", "items": {"type": "string"}},
        "allowed_paths": {"type": "array", "items": {"type": "string"}},
        "forbidden_paths": {"type": "array", "items": {"type": "string"}}
      }
    },
    "depends_on": {"type": "array", "items": {"type": "string"}},
    "required_gates": {"type": "array", "items": {"type": "string"}},
    "required_environment": {"type": "array", "items": {"type": "string"}},
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "version", "required"],
        "properties": {
          "path": {"type": "string"},
          "version": {"type": "string"},
          "required": {"type": "boolean"}
        }
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "description"],
        "properties": {
          "path": {"type": "string"},
          "description": {"type": "string"}
        }
      },
      "minItems": 1
    },
    "acceptance_criteria": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "test_plan": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "level", "reason", "owner", "unblock_evidence"],
        "properties": {
          "id": {"type": "string"},
          "level": {"enum": ["B0", "B1", "B2", "B3", "B4"]},
          "reason": {"type": "string"},
          "owner": {"type": "string"},
          "unblock_evidence": {"type": "string"}
        }
      }
    },
    "owner_decision": {"type": ["string", "null"]},
    "branch": {"type": ["string", "null"]},
    "pr_number": {"type": ["integer", "null"], "minimum": 1},
    "evidence_paths": {"type": "array", "items": {"type": "string"}}
  }
}
